{
  "name": "biomaker-desktop",
  "version": "0.1.23",
  "private": true,
  "description": "BioMaker — a desktop workspace for biomedical model development",
  "author": "BioMaker contributors",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:ui": "tsc --noEmit && vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "npm run build:ui && npm run build:electron",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "icons": "node scripts/build-icons.mjs",
    "start": "electron .",
    "test": "npm run build:electron && node --test dist-electron/*.test.js scripts/check-package.test.cjs && npm run test:close-protection && npm run test:activity && npm run test:candidates && npm run test:report-ui",
    "test:close-protection": "node --experimental-strip-types --test tests/close-protection.test.mjs",
    "test:e2e": "node tests/electron-smoke.mjs",
    "package:mac": "npm run build && electron-builder --config electron-builder.yml --mac --arm64",
    "package:dir": "npm run build && electron-builder --config electron-builder.yml --dir",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "lock:engine": "node scripts/lock-engine.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "test:activity": "node --experimental-strip-types --test tests/event-presentation.test.mjs",
    "test:candidates": "node --experimental-strip-types --test tests/candidate-records.test.mjs",
    "test:report-ui": "node --experimental-strip-types --test tests/markdown.test.mjs tests/draft-errors.test.mjs"
  },
  "dependencies": {
    "json5": "2.2.3",
    "lucide-react": "1.53.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "sharp": "0.35.5",
    "typescript": "^5.9.0",
    "vite": "8.3.3"
  },
  "overrides": {
    "global-agent": "4.1.3"
  }
}
